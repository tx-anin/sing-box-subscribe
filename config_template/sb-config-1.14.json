        "America",
        "Others",
        "Proxy",
        "direct"
      ],
      "default": "Proxy"
    },
    {
      "tag": "Apple",
      "type": "selector",
      "outbounds": [
        "direct",
        "HongKong",
        "Singapore",
        "Japan",
        "America",
        "Others",
        "Proxy"
      ],
      "default": "direct"
    },
    {
      "tag": "Microsoft",
      "type": "selector",
      "outbounds": [
        "HongKong",
        "Singapore",
        "Japan",
        "America",
        "Others",
        "Proxy",
        "direct"
      ],
